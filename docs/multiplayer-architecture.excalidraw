{
  "type": "excalidraw",
  "version": 2,
  "source": "polaris",
  "elements": [
    { "id": "title", "type": "text", "x": 40, "y": 10, "width": 1080, "height": 70, "text": "Polaris: authoritative turns, mobile clients", "fontSize": 28, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "left", "verticalAlign": "top" },
    { "id": "clients", "type": "rectangle", "x": 30, "y": 110, "width": 330, "height": 470, "strokeColor": "#1864ab", "backgroundColor": "transparent", "strokeWidth": 2 },
    { "id": "android", "type": "rectangle", "x": 50, "y": 140, "width": 290, "height": 100, "strokeColor": "#1864ab", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "boundElements": [{"type":"text","id":"android-label"}] },
    { "id": "android-label", "type": "text", "containerId": "android", "x": 65, "y": 165, "width": 260, "height": 50, "text": "Android Chrome / PWA", "fontSize": 20, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "center", "verticalAlign": "middle" },
    { "id": "ios", "type": "rectangle", "x": 50, "y": 270, "width": 290, "height": 100, "strokeColor": "#1864ab", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "boundElements": [{"type":"text","id":"ios-label"}] },
    { "id": "ios-label", "type": "text", "containerId": "ios", "x": 65, "y": 295, "width": 260, "height": 50, "text": "iOS Safari / PWA", "fontSize": 20, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "center", "verticalAlign": "middle" },
    { "id": "cache", "type": "rectangle", "x": 50, "y": 400, "width": 290, "height": 150, "strokeColor": "#495057", "backgroundColor": "#dee2e6", "fillStyle": "solid", "boundElements": [{"type":"text","id":"cache-label"}] },
    { "id": "cache-label", "type": "text", "containerId": "cache", "x": 65, "y": 420, "width": 260, "height": 110, "text": "Static shell cache only\nNo API / hidden-world cache", "fontSize": 18, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "center", "verticalAlign": "middle" },
    { "id": "api", "type": "rectangle", "x": 530, "y": 140, "width": 330, "height": 190, "strokeColor": "#e67700", "backgroundColor": "#fff3bf", "fillStyle": "solid", "boundElements": [{"type":"text","id":"api-label"}] },
    { "id": "api-label", "type": "text", "containerId": "api", "x": 545, "y": 155, "width": 300, "height": 160, "text": "Node 24 same-origin API\nSession + invite admission\nRevision + request ID checks", "fontSize": 18, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "center", "verticalAlign": "middle" },
    { "id": "rules", "type": "rectangle", "x": 530, "y": 420, "width": 330, "height": 190, "strokeColor": "#2f9e44", "backgroundColor": "#b2f2bb", "fillStyle": "solid", "boundElements": [{"type":"text","id":"rules-label"}] },
    { "id": "rules-label", "type": "text", "containerId": "rules", "x": 545, "y": 435, "width": 300, "height": 160, "text": "Pure deterministic rules\nOne active faction\nPlayer-specific fog projection", "fontSize": 18, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "center", "verticalAlign": "middle" },
    { "id": "db", "type": "rectangle", "x": 1030, "y": 260, "width": 330, "height": 230, "strokeColor": "#495057", "backgroundColor": "#dee2e6", "fillStyle": "solid", "boundElements": [{"type":"text","id":"db-label"}] },
    { "id": "db-label", "type": "text", "containerId": "db", "x": 1045, "y": 275, "width": 300, "height": 200, "text": "SQLite WAL / durable volume\nVersioned accepted history\nAtomic request receipts\nHashed capabilities", "fontSize": 18, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "center", "verticalAlign": "middle" },
    { "id": "requests", "type": "arrow", "x": 360, "y": 210, "width": 170, "height": 0, "strokeColor": "#1864ab", "strokeWidth": 2, "points": [[0,0],[170,0]], "endArrowhead": "arrow" },
    { "id": "request-label", "type": "text", "x": 370, "y": 120, "width": 150, "height": 90, "text": "HTTPS intents\n+ foreground poll", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "center", "verticalAlign": "top" },
    { "id": "views", "type": "arrow", "x": 530, "y": 360, "width": 170, "height": 0, "strokeColor": "#1864ab", "strokeWidth": 2, "points": [[0,0],[-170,0]], "endArrowhead": "arrow" },
    { "id": "view-label", "type": "text", "x": 370, "y": 380, "width": 150, "height": 90, "text": "Redacted view\nNo seed or RNG", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "center", "verticalAlign": "top" },
    { "id": "resolve", "type": "arrow", "x": 690, "y": 330, "width": 0, "height": 90, "strokeColor": "#2f9e44", "strokeWidth": 2, "points": [[0,0],[0,90]], "endArrowhead": "arrow" },
    { "id": "persist", "type": "arrow", "x": 860, "y": 270, "width": 170, "height": 60, "strokeColor": "#495057", "strokeWidth": 2, "points": [[0,0],[170,60]], "endArrowhead": "arrow" },
    { "id": "commit-label", "type": "text", "x": 880, "y": 170, "width": 140, "height": 100, "text": "Commit once\nRestore on restart", "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "center", "verticalAlign": "top" },
    { "id": "boundary", "type": "text", "x": 40, "y": 650, "width": 1300, "height": 100, "text": "Single-server private-room foundation. HTTPS required outside loopback.\nNative stores, accounts, push notifications and multi-node hosting are separate release work.", "fontSize": 18, "fontFamily": 2, "strokeColor": "#000000", "textAlign": "left", "verticalAlign": "top" }
  ],
  "appState": { "viewBackgroundColor": "#ffffff" }
}
